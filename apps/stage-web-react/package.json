{
  "name": "@proj-aipets/stage-web-react",
  "productName": "aipets",
  "type": "module",
  "version": "0.12.0",
  "private": true,
  "description": "React frontend for aipets",
  "author": {
    "name": "aipets",
    "url": "https://gitee.com/kallen-noelle/AdoptAI"
  },
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host",
    "dev:electron": "vite --host",
    "electron": "electron electron/main.cjs",
    "electron:build": "vite build && electron electron/main.cjs",
    "electron:dist": "vite build && electron-builder --win --config electron-builder.config.cjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@moeru/std": "catalog:",
    "@proj-aipets/character-animation": "workspace:^",
    "@proj-aipets/i18n": "workspace:^",
    "@proj-aipets/provider-inference": "workspace:^",
    "i18next": "catalog:",
    "idb-keyval": "catalog:",
    "jszip": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@iconify-json/simple-icons": "catalog:",
    "@iconify-json/solar": "catalog:",
    "@iconify/tailwind4": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
