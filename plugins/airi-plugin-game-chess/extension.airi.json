{
  "manifestVersion": 2,
  "kind": "manifest.extension.airi.moeru.ai",
  "id": "airi-plugin-game-chess",
  "version": "0.12.0",
  "engines": {
    "airi": "*",
    "runtimes": [
      "electron"
    ]
  },
  "entrypoints": {
    "electron": "./airi-plugin-game-chess.mjs"
  },
  "permissions": {
    "apis": [
      {
        "key": "kit.gamelet",
        "actions": [
          "invoke"
        ]
      }
    ],
    "resources": [
      {
        "key": "proj-airi:plugin-sdk:resources:kits:kit.gamelet:bindings",
        "actions": [
          "write"
        ]
      }
    ]
  }
}
