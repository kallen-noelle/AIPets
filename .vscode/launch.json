{
  "version": "0.2.0",
  "configurations": [
    {
      // Start `pnpm -F @proj-airi/stage-web-react dev` first. This launches the
      // Electron main process against the running Vite server.
      "name": "Debug Electron main process",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "-F",
        "@proj-airi/stage-web-react",
        "exec",
        "electron",
        "electron/main.cjs",
        "--remote-debugging-port=9222"
      ],
      "cwd": "${workspaceFolder}/apps/stage-web-react",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Attach renderer process",
      "port": 9222,
      "request": "attach",
      "type": "chrome",
      "webRoot": "${workspaceFolder}/apps/stage-web-react/src",
      "timeout": 60000,
      "presentation": {
        "hidden": true
      }
    }
  ],
  "compounds": [
    {
      "name": "Debug All",
      "configurations": ["Debug Electron main process", "Attach renderer process"],
      "presentation": {
        "order": 1
      }
    }
  ]
}
