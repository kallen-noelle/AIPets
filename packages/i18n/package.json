{
  "name": "@proj-aipets/i18n",
  "type": "module",
  "private": true,
  "description": "Internationalization (i18n) locales and utilities for Project AIPETS",
  "author": {
    "name": "Moeru AI Project AIPETS Team",
    "email": "aipets@moeru.ai",
    "url": "https://github.com/moeru-ai"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/kallen-noelle/AdoptAI.git",
    "directory": "packages/i18n"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./locales": {
      "types": "./dist/locales/index.d.mts",
      "default": "./dist/locales/index.mjs"
    },
    "./locales/en": {
      "types": "./dist/locales/en/index.d.mts",
      "default": "./dist/locales/en/index.mjs"
    },
    "./locales/zh-Hans": {
      "types": "./dist/locales/zh-Hans/index.d.mts",
      "default": "./dist/locales/zh-Hans/index.mjs"
    },
    "./locales/*.yaml": {
      "default": "./dist/locales/*.yaml"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "test:run": "vitest run --config vitest.config.ts",
    "dev": "pnpm run build",
    "build": "tsdown",
    "glossary:build": "tsx glossary/build-tbx.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "unplugin-yaml": "catalog:",
    "valibot": "catalog:",
    "xast-util-to-xml": "catalog:",
    "xastscript": "catalog:",
    "yaml": "catalog:"
  }
}
