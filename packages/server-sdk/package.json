{
  "name": "@proj-aipets/server-sdk",
  "type": "module",
  "version": "0.12.0",
  "description": "Client-side SDK implementation for connecting to AIPETS server components and runtimes",
  "author": {
    "name": "Moeru AI Project AIPETS Team",
    "email": "aipets@moeru.ai",
    "url": "https://github.com/moeru-ai"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/kallen-noelle/AdoptAI.git",
    "directory": "packages/server-sdk"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./utils/node": {
      "types": "./dist/utils/node/index.d.mts",
      "default": "./dist/utils/node/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "test:run": "vitest run --config vitest.config.ts",
    "dev": "pnpm run build",
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@moeru/std": "catalog:",
    "@proj-aipets/better-ws": "workspace:^",
    "@proj-aipets/server-shared": "workspace:^",
    "superjson": "catalog:",
    "valibot": "catalog:"
  }
}
