{
  "name": "@proj-aipets/plugin-sdk",
  "type": "module",
  "version": "0.12.0",
  "private": true,
  "description": "Plugin SDK for Project AIPETS",
  "author": {
    "name": "Moeru AI Project AIPETS Team",
    "email": "aipets@moeru.ai",
    "url": "https://github.com/moeru-ai"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/kallen-noelle/AdoptAI.git",
    "directory": "packages/plugin-sdk"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./plugin-host": {
      "types": "./dist/plugin-host/index.d.mts",
      "node": "./dist/plugin-host/runtimes/node/index.mjs",
      "default": "./dist/plugin-host/runtimes/web/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "test:run": "vitest run --config vitest.config.ts",
    "build": "tsdown",
    "dev": "pnpm run build",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@moeru/eventa": "catalog:",
    "@moeru/std": "catalog:",
    "@proj-aipets/plugin-protocol": "workspace:*",
    "nanoid": "catalog:",
    "semver": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/semver": "catalog:",
    "es-toolkit": "catalog:"
  }
}
